SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:4321/api/auth/callback
# At least 32 random characters. Used to encrypt the HTTP-only session cookie.
SESSION_SECRET=

# Supabase (Online Mode). Keep the secret key server-only; never expose it to browser code.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Browser-safe values used only to subscribe to safe Realtime room snapshots.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
